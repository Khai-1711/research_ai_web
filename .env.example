# Research AI Web (FastAPI Backend) — Environment Configuration
HOST=127.0.0.1
PORT=3000

# Local dsh-gemini-bridge Frontend Gateway URL (https://github.com/Khai-1711/dsh-gemini-bridge)
BRIDGE_URL=http://127.0.0.1:10000
BRIDGE_API_KEY=

# Default model on Bridge (can be overridden per AI perspective & Judge in UI)
DEFAULT_MODEL=gemini-4-hydrogen
BRIDGE_TIMEOUT_S=250
BRIDGE_MAX_RETRIES=2
