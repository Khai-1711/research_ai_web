# GEMINI_API_KEY: Required for Gemini AI API calls on the AI Studio server proxy.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional local dsh-gemini-bridge endpoint (e.g. http://127.0.0.1:10000)
# When set, the server adapter routes stateless non-stream calls through dsh-gemini-bridge.
BRIDGE_URL=""
